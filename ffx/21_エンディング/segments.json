[
  {
    "start": "8:10:02",
    "end": "8:10:05",
    "text": "私を消しても",
    "audio_file": "clip_000.mp3"
  },
  {
    "start": "8:10:06",
    "end": "8:10:13",
    "text": "スピラの悲しみは消えはしない",
    "audio_file": "clip_001.mp3"
  },
  {
    "start": "8:10:20",
    "end": "8:10:23",
    "text": "シンゴと消してやるよ",
    "audio_file": "clip_002.mp3"
  },
  {
    "start": "8:11:12",
    "end": "8:11:14",
    "text": "おすいぞ アーロン",
    "audio_file": "clip_003.mp3"
  },
  {
    "start": "8:11:16",
    "end": "8:11:18",
    "text": "つつま",
    "audio_file": "clip_004.mp3"
  },
  {
    "start": "8:11:51",
    "end": "8:11:55",
    "text": "まだ、あんたのほうがデカい",
    "audio_file": "clip_005.mp3"
  },
  {
    "start": "8:11:58",
    "end": "8:12:02",
    "text": "なんつっても俺はシンだからな",
    "audio_file": "clip_006.mp3"
  },
  {
    "start": "8:12:03",
    "end": "8:12:06",
    "text": "笑えないっつうの",
    "audio_file": "clip_007.mp3"
  },
  {
    "start": "8:12:13",
    "end": "8:12:19",
    "text": "じゃあ、まあなんだ / その…",
    "audio_file": "clip_008.mp3"
  },
  {
    "start": "8:12:21",
    "end": "8:12:23",
    "text": "蹴りつけっか?",
    "audio_file": "clip_009.mp3"
  },
  {
    "start": "8:12:24",
    "end": "8:12:26",
    "text": "親父…",
    "audio_file": "clip_010.mp3"
  },
  {
    "start": "8:12:28",
    "end": "8:12:30",
    "text": "馬鹿",
    "audio_file": "clip_011.mp3"
  },
  {
    "start": "8:12:37",
    "end": "8:12:40",
    "text": "それでいいさ",
    "audio_file": "clip_012.mp3"
  },
  {
    "start": "8:12:41",
    "end": "8:12:45",
    "text": "どうすりゃいいかわかってんな",
    "audio_file": "clip_013.mp3"
  },
  {
    "start": "8:12:50",
    "end": "8:12:54",
    "text": "もう歌もあんまし 聞こえねえんだ",
    "audio_file": "clip_014.mp3"
  },
  {
    "start": "8:12:56",
    "end": "8:13:03",
    "text": "もうちょっとで 俺は 心の底からシンになっちまう",
    "audio_file": "clip_015.mp3"
  },
  {
    "start": "8:13:04",
    "end": "8:13:07",
    "text": "間に合って助かったぜ",
    "audio_file": "clip_016.mp3"
  },
  {
    "start": "8:13:10",
    "end": "8:13:19",
    "text": "でよ、始まっちまったら、俺は壊れちまう。",
    "audio_file": "clip_017.mp3"
  },
  {
    "start": "8:13:20",
    "end": "8:13:24",
    "text": "手加減とか、できねえからよ。",
    "audio_file": "clip_018.mp3"
  },
  {
    "start": "8:13:27",
    "end": "8:13:31",
    "text": "すまねえな。 / もういいって。",
    "audio_file": "clip_019.mp3"
  },
  {
    "start": "8:13:32",
    "end": "8:13:34",
    "text": "うだうだ言ってないでさ。",
    "audio_file": "clip_020.mp3"
  },
  {
    "start": "8:13:35",
    "end": "8:13:36",
    "text": "だな。",
    "audio_file": "clip_021.mp3"
  },
  {
    "start": "8:13:51",
    "end": "8:13:54",
    "text": "자, 이처에 가볼까?",
    "audio_file": "clip_022.mp3"
  },
  {
    "start": "8:17:10",
    "end": "8:17:14",
    "text": "泣くぞ / すぐ泣くぞ",
    "audio_file": "clip_023.mp3"
  },
  {
    "start": "8:17:15",
    "end": "8:17:18",
    "text": "絶対泣くぞ / ほら泣くぞ",
    "audio_file": "clip_024.mp3"
  },
  {
    "start": "8:17:23",
    "end": "8:17:28",
    "text": "大嫌いだ",
    "audio_file": "clip_025.mp3"
  },
  {
    "start": "8:17:36",
    "end": "8:17:40",
    "text": "まだ早いぜ",
    "audio_file": "clip_026.mp3"
  },
  {
    "start": "8:17:40",
    "end": "8:17:41",
    "text": "全部",
    "audio_file": "clip_027.mp3"
  },
  {
    "start": "8:17:42",
    "end": "8:17:45",
    "text": "終わらせてからだよな",
    "audio_file": "clip_028.mp3"
  },
  {
    "start": "8:17:48",
    "end": "8:17:57",
    "text": "わかってるじゃねえか / さすがチェクト様のガキだ",
    "audio_file": "clip_029.mp3"
  },
  {
    "start": "8:17:57",
    "end": "8:18:00",
    "text": "初めて思った",
    "audio_file": "clip_030.mp3"
  },
  {
    "start": "8:18:02",
    "end": "8:18:04",
    "text": "あんたの息子で",
    "audio_file": "clip_031.mp3"
  },
  {
    "start": "8:18:05",
    "end": "8:18:08",
    "text": "よかった / ケッ",
    "audio_file": "clip_032.mp3"
  },
  {
    "start": "8:18:09",
    "end": "8:18:12",
    "text": "チェクトさん / あの…",
    "audio_file": "clip_033.mp3"
  },
  {
    "start": "8:18:13",
    "end": "8:18:15",
    "text": "ダメだ / ユーナちゃん",
    "audio_file": "clip_034.mp3"
  },
  {
    "start": "8:18:16",
    "end": "8:18:18",
    "text": "時間がねえ",
    "audio_file": "clip_035.mp3"
  },
  {
    "start": "8:18:21",
    "end": "8:18:26",
    "text": "邪魔するじゃねえ! / ユーナちゃん / わかってんな",
    "audio_file": "clip_036.mp3"
  },
  {
    "start": "8:18:27",
    "end": "8:18:32",
    "text": "召喚獣を / 僕たちを",
    "audio_file": "clip_037.mp3"
  },
  {
    "start": "8:18:33",
    "end": "8:18:38",
    "text": "呼ぶんだぞ / 呼ぶんだよ",
    "audio_file": "clip_038.mp3"
  },
  {
    "start": "8:19:53",
    "end": "8:19:55",
    "text": "ユーラ!",
    "audio_file": "clip_039.mp3"
  },
  {
    "start": "8:23:05",
    "end": "8:23:07",
    "text": "みんな!",
    "audio_file": "clip_040.mp3"
  },
  {
    "start": "8:23:08",
    "end": "8:23:13",
    "text": "一緒に戦えるのは、これが最後だ!",
    "audio_file": "clip_041.mp3"
  },
  {
    "start": "8:23:14",
    "end": "8:23:17",
    "text": "よろしく!",
    "audio_file": "clip_042.mp3"
  },
  {
    "start": "8:23:18",
    "end": "8:23:22",
    "text": "なんつったらいいかな",
    "audio_file": "clip_043.mp3"
  },
  {
    "start": "8:23:23",
    "end": "8:23:25",
    "text": "エボンジュを倒したら",
    "audio_file": "clip_044.mp3"
  },
  {
    "start": "8:23:26",
    "end": "8:23:28",
    "text": "俺、消えっから",
    "audio_file": "clip_045.mp3"
  },
  {
    "start": "8:23:29",
    "end": "8:23:33",
    "text": "あんた、何言ってんのよ",
    "audio_file": "clip_046.mp3"
  },
  {
    "start": "8:23:56",
    "end": "8:24:01",
    "text": "さよならってこと! / そんな...",
    "audio_file": "clip_047.mp3"
  },
  {
    "start": "8:24:02",
    "end": "8:24:08",
    "text": "勝手で悪いけどさ、これが俺の物語だ!",
    "audio_file": "clip_048.mp3"
  },
  {
    "start": "8:26:14",
    "end": "8:26:16",
    "text": "Субтитры создавал DimaTorzok",
    "audio_file": "clip_049.mp3"
  },
  {
    "start": "8:29:36",
    "end": "8:29:39",
    "text": "続けろ / でも…",
    "audio_file": "clip_050.mp3"
  },
  {
    "start": "8:29:44",
    "end": "8:29:46",
    "text": "これでいいぞ",
    "audio_file": "clip_051.mp3"
  },
  {
    "start": "8:30:14",
    "end": "8:30:18",
    "text": "10年、待たせたからな",
    "audio_file": "clip_052.mp3"
  },
  {
    "start": "8:30:33",
    "end": "8:30:39",
    "text": "もう、お前たちの時代だ",
    "audio_file": "clip_053.mp3"
  },
  {
    "start": "8:32:42",
    "end": "8:32:45",
    "text": "俺…帰らなくちゃ!",
    "audio_file": "clip_054.mp3"
  },
  {
    "start": "8:32:51",
    "end": "8:32:54",
    "text": "ザナルカウント案内できなくて、ごめんな!",
    "audio_file": "clip_055.mp3"
  },
  {
    "start": "8:33:02",
    "end": "8:33:05",
    "text": "じゃあな! / えっ?",
    "audio_file": "clip_056.mp3"
  },
  {
    "start": "8:33:06",
    "end": "8:33:09",
    "text": "また会えるんだよね? / ねえ?",
    "audio_file": "clip_057.mp3"
  },
  {
    "start": "8:33:14",
    "end": "8:33:15",
    "text": "ユーノ! / 快",
    "audio_file": "clip_058.mp3"
  },
  {
    "start": "8:33:59",
    "end": "8:34:02",
    "text": "ありがとう",
    "audio_file": "clip_059.mp3"
  },
  {
    "start": "8:35:33",
    "end": "8:35:36",
    "text": "言うな サラサラ",
    "audio_file": "clip_060.mp3"
  },
  {
    "start": "8:36:03",
    "end": "8:36:08",
    "text": "多くの数え切れない犠牲がありました",
    "audio_file": "clip_061.mp3"
  },
  {
    "start": "8:36:10",
    "end": "8:36:17",
    "text": "何をなくしたのかわからないくらいたくさん なくしました",
    "audio_file": "clip_062.mp3"
  },
  {
    "start": "8:36:20",
    "end": "8:36:26",
    "text": "その代わり もう / シンはいません",
    "audio_file": "clip_063.mp3"
  },
  {
    "start": "8:36:28",
    "end": "8:36:30",
    "text": "もしません",
    "audio_file": "clip_064.mp3"
  },
  {
    "start": "8:36:34",
    "end": "8:36:35",
    "text": "これから",
    "audio_file": "clip_065.mp3"
  },
  {
    "start": "8:36:37",
    "end": "8:36:41",
    "text": "これからは 私たちの時代",
    "audio_file": "clip_066.mp3"
  },
  {
    "start": "8:36:42",
    "end": "8:36:43",
    "text": "だよね",
    "audio_file": "clip_067.mp3"
  },
  {
    "start": "8:36:46",
    "end": "8:36:52",
    "text": "いっぱいあるけど 時間もいっぱいあるから",
    "audio_file": "clip_068.mp3"
  },
  {
    "start": "8:36:55",
    "end": "8:36:58",
    "text": "だから 大丈夫だよね",
    "audio_file": "clip_069.mp3"
  },
  {
    "start": "8:37:03",
    "end": "8:37:08",
    "text": "力を合わせて 一緒に歩けるよね",
    "audio_file": "clip_070.mp3"
  },
  {
    "start": "8:37:22",
    "end": "8:37:26",
    "text": "一つだけお願いがあります",
    "audio_file": "clip_071.mp3"
  },
  {
    "start": "8:37:28",
    "end": "8:37:34",
    "text": "いなくなってしまった人たちのこと",
    "audio_file": "clip_072.mp3"
  },
  {
    "start": "8:37:35",
    "end": "8:37:39",
    "text": "時々でいいから",
    "audio_file": "clip_073.mp3"
  },
  {
    "start": "8:37:50",
    "end": "8:37:53",
    "text": "思い出してください",
    "audio_file": "clip_074.mp3"
  },
  {
    "start": "8:38:08",
    "end": "8:38:15",
    "text": "風が寄せた言葉に",
    "audio_file": "clip_075.mp3"
  },
  {
    "start": "8:38:16",
    "end": "8:38:21",
    "text": "泳いだ心",
    "audio_file": "clip_076.mp3"
  },
  {
    "start": "8:38:22",
    "end": "8:38:35",
    "text": "雲が運ぶ明日に 弾んだ声",
    "audio_file": "clip_077.mp3"
  },
  {
    "start": "8:38:35",
    "end": "8:38:49",
    "text": "月が揺れる鏡に 震えた心",
    "audio_file": "clip_078.mp3"
  },
  {
    "start": "8:38:50",
    "end": "8:39:02",
    "text": "星が流れこぼれた やわらかい涙",
    "audio_file": "clip_079.mp3"
  },
  {
    "start": "8:39:04",
    "end": "8:39:18",
    "text": "素敵だね 二人手を取り歩けたなら",
    "audio_file": "clip_080.mp3"
  },
  {
    "start": "8:39:19",
    "end": "8:39:33",
    "text": "行きたいよ 君の街家 上の中",
    "audio_file": "clip_081.mp3"
  },
  {
    "start": "8:39:34",
    "end": "8:39:45",
    "text": "その胸 からだあつけ",
    "audio_file": "clip_082.mp3"
  },
  {
    "start": "8:39:47",
    "end": "8:40:01",
    "text": "夜に庭切れ 夢見る",
    "audio_file": "clip_083.mp3"
  },
  {
    "start": "8:40:59",
    "end": "8:41:11",
    "text": "手は止まり言葉は やさしい幻",
    "audio_file": "clip_084.mp3"
  },
  {
    "start": "8:41:12",
    "end": "8:41:24",
    "text": "雲は破れ 明日は遠くも越え",
    "audio_file": "clip_085.mp3"
  },
  {
    "start": "8:41:25",
    "end": "8:41:37",
    "text": "月がにじむ鏡を 流れた心",
    "audio_file": "clip_086.mp3"
  },
  {
    "start": "8:41:38",
    "end": "8:41:53",
    "text": "星が揺れてこぼれた 隠せない涙",
    "audio_file": "clip_087.mp3"
  },
  {
    "start": "8:41:54",
    "end": "8:42:08",
    "text": "素敵だね 二人手を取りあげたなら",
    "audio_file": "clip_088.mp3"
  },
  {
    "start": "8:42:09",
    "end": "8:42:23",
    "text": "生きたいよ 君の街へ 生んでこまる",
    "audio_file": "clip_089.mp3"
  },
  {
    "start": "8:42:23",
    "end": "8:42:50",
    "text": "その顔 そっと触れて 朝に溶ける夢見る",
    "audio_file": "clip_090.mp3"
  },
  {
    "start": "8:42:51",
    "end": "8:43:05",
    "text": "好きだね 二人手を取り歩けたなら",
    "audio_file": "clip_091.mp3"
  },
  {
    "start": "8:43:06",
    "end": "8:43:20",
    "text": "生きたいよ 君の街家 腕を巻く",
    "audio_file": "clip_092.mp3"
  },
  {
    "start": "8:43:21",
    "end": "8:43:33",
    "text": "その胸 体あつけ",
    "audio_file": "clip_093.mp3"
  },
  {
    "start": "8:43:34",
    "end": "8:43:46",
    "text": "夜に紛れ 夢に舞う",
    "audio_file": "clip_094.mp3"
  }
]