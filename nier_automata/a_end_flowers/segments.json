[
  {
    "start": "02:58:03",
    "end": "02:58:05",
    "text": "これで",
    "audio_file": "clip_000.mp3"
  },
  {
    "start": "02:58:07",
    "end": "02:58:08",
    "text": "全部",
    "audio_file": "clip_001.mp3"
  },
  {
    "start": "02:58:31",
    "end": "02:58:33",
    "text": "失敗しちゃった",
    "audio_file": "clip_002.mp3"
  },
  {
    "start": "02:58:41",
    "end": "02:58:46",
    "text": "イヴのネットワーク分離時に物理汚染されちゃったみたい",
    "audio_file": "clip_003.mp3"
  },
  {
    "start": "02:58:50",
    "end": "02:58:53",
    "text": "そんな / 大丈夫",
    "audio_file": "clip_004.mp3"
  },
  {
    "start": "02:58:54",
    "end": "02:58:58",
    "text": "バンカーにあるデータで巻き戻ることができるから",
    "audio_file": "clip_005.mp3"
  },
  {
    "start": "02:59:00",
    "end": "02:59:03",
    "text": "でもそれじゃ今の君は戻ってこない",
    "audio_file": "clip_006.mp3"
  },
  {
    "start": "02:59:05",
    "end": "02:59:12",
    "text": "そうだね / 汚染データをバンカーにアップロードするわけにも",
    "audio_file": "clip_007.mp3"
  },
  {
    "start": "02:59:14",
    "end": "02:59:15",
    "text": "いかないから",
    "audio_file": "clip_008.mp3"
  },
  {
    "start": "02:59:18",
    "end": "02:59:19",
    "text": "はいイエス",
    "audio_file": "clip_009.mp3"
  },
  {
    "start": "03:00:02",
    "end": "03:00:03",
    "text": "Субтитры создавал DimaTorzok",
    "audio_file": "clip_010.mp3"
  },
  {
    "start": "03:00:19",
    "end": "03:00:20",
    "text": "妈",
    "audio_file": "clip_011.mp3"
  },
  {
    "start": "03:01:18",
    "end": "03:01:20",
    "text": "うっ / うっ…",
    "audio_file": "clip_012.mp3"
  },
  {
    "start": "03:01:42",
    "end": "03:01:44",
    "text": "まだ… / 残ってるのか…",
    "audio_file": "clip_013.mp3"
  },
  {
    "start": "03:01:56",
    "end": "03:01:58",
    "text": "こんな機械",
    "audio_file": "clip_014.mp3"
  },
  {
    "start": "03:02:06",
    "end": "03:02:12",
    "text": "これは通信 / データ信号が共鳴しあって",
    "audio_file": "clip_015.mp3"
  },
  {
    "start": "03:02:27",
    "end": "03:02:30",
    "text": "СПОКОЙНАЯ МУЗЫКА",
    "audio_file": "clip_016.mp3"
  },
  {
    "start": "03:02:46",
    "end": "03:02:49",
    "text": "ちょっと待って2B / 君は",
    "audio_file": "clip_017.mp3"
  },
  {
    "start": "03:02:51",
    "end": "03:02:54",
    "text": "僕パーソナルデータを機械生命体側に残していたみたいで",
    "audio_file": "clip_018.mp3"
  },
  {
    "start": "03:02:55",
    "end": "03:02:58",
    "text": "なんか気づいたら周囲のネットワークの上で自我が再形成されたんだ",
    "audio_file": "clip_019.mp3"
  },
  {
    "start": "03:02:59",
    "end": "03:03:03",
    "text": "こうやって複数の自我が統合されていくのは貴重な体験だから記録しておきたいんだけど",
    "audio_file": "clip_020.mp3"
  },
  {
    "start": "03:03:04",
    "end": "03:03:09",
    "text": "まだ保存領域へのアクセスができてなくて / とりあえずこの辺りにある敵のメモリーに多重化して保存しておいた後に",
    "audio_file": "clip_021.mp3"
  },
  {
    "start": "03:03:10",
    "end": "03:03:12",
    "text": "僕が自分のボディに戻ったんです",
    "audio_file": "clip_022.mp3"
  },
  {
    "start": "03:03:14",
    "end": "03:03:15",
    "text": "よかった",
    "audio_file": "clip_023.mp3"
  },
  {
    "start": "03:03:29",
    "end": "03:03:34",
    "text": "機械生命体と私たちアンドロイドを分かつものは何だろうか",
    "audio_file": "clip_024.mp3"
  },
  {
    "start": "03:03:35",
    "end": "03:03:37",
    "text": "意思と感情を持つに至ったロボットたち",
    "audio_file": "clip_025.mp3"
  },
  {
    "start": "03:03:40",
    "end": "03:03:44",
    "text": "彼らが死の間際に振り絞る最後の叫びが",
    "audio_file": "clip_026.mp3"
  },
  {
    "start": "03:03:46",
    "end": "03:03:50",
    "text": "今もまだ私の中に残っている",
    "audio_file": "clip_027.mp3"
  }
]