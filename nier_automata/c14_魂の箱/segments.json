[
  {
    "start": "07:06:33",
    "end": "07:06:38",
    "text": "「警告",
    "audio_file": "clip_000.mp3"
  },
  {
    "start": "07:06:57",
    "end": "07:07:08",
    "text": "アクセス可能な位置に稼働中の敵大型ユニットを確認。 マップ2ユニットの場所をマーク。",
    "audio_file": "clip_001.mp3"
  },
  {
    "start": "07:07:22",
    "end": "07:07:26",
    "text": "こんにちは 次元回収ユニットです",
    "audio_file": "clip_002.mp3"
  },
  {
    "start": "07:07:27",
    "end": "07:07:32",
    "text": "防衛態勢に入ります",
    "audio_file": "clip_003.mp3"
  },
  {
    "start": "07:07:32",
    "end": "07:07:34",
    "text": "「魂の箱」",
    "audio_file": "clip_004.mp3"
  },
  {
    "start": "07:07:54",
    "end": "07:08:02",
    "text": "また… なにか書いてあるな / 魂の箱 溶き砕い",
    "audio_file": "clip_005.mp3"
  },
  {
    "start": "07:08:54",
    "end": "07:08:59",
    "text": "第1回 敵",
    "audio_file": "clip_006.mp3"
  },
  {
    "start": "07:09:30",
    "end": "07:09:36",
    "text": "そういうことか / システムプロテクトを解除しないと / コアまでたどり着けない",
    "audio_file": "clip_007.mp3"
  },
  {
    "start": "07:09:37",
    "end": "07:09:41",
    "text": "そういう仕組みか",
    "audio_file": "clip_008.mp3"
  },
  {
    "start": "07:10:55",
    "end": "07:11:02",
    "text": "車室 / あのでかい構造物は何かの発車台なんだ",
    "audio_file": "clip_009.mp3"
  },
  {
    "start": "07:11:02",
    "end": "07:11:06",
    "text": "あれだけの施設 / 宇宙に向けて",
    "audio_file": "clip_010.mp3"
  },
  {
    "start": "07:11:06",
    "end": "07:11:09",
    "text": "まさか月面の人類サーバーを狙った",
    "audio_file": "clip_011.mp3"
  },
  {
    "start": "07:11:10",
    "end": "07:11:16",
    "text": "大砲 / 情報義足に立て / 否定無行程も深いので / くそ",
    "audio_file": "clip_012.mp3"
  },
  {
    "start": "07:12:29",
    "end": "07:12:38",
    "text": "ヨルハ部隊のブラックボックス回路が機械生命体のコアでできてる / そんなバカな",
    "audio_file": "clip_013.mp3"
  },
  {
    "start": "07:12:39",
    "end": "07:12:44",
    "text": "そんなことあるはずない",
    "audio_file": "clip_014.mp3"
  },
  {
    "start": "07:13:12",
    "end": "07:13:23",
    "text": "あれ…なんだこれ…体が…これは…僕の記憶…どうして…",
    "audio_file": "clip_015.mp3"
  },
  {
    "start": "07:13:41",
    "end": "07:13:44",
    "text": "2Bのデータ…",
    "audio_file": "clip_016.mp3"
  },
  {
    "start": "07:13:48",
    "end": "07:13:53",
    "text": "これが思い出だとしても…",
    "audio_file": "clip_017.mp3"
  },
  {
    "start": "07:13:53",
    "end": "07:13:56",
    "text": "僕は…",
    "audio_file": "clip_018.mp3"
  },
  {
    "start": "07:13:59",
    "end": "07:14:02",
    "text": "やめろ…",
    "audio_file": "clip_019.mp3"
  },
  {
    "start": "07:14:02",
    "end": "07:14:05",
    "text": "やめろ…",
    "audio_file": "clip_020.mp3"
  },
  {
    "start": "07:14:05",
    "end": "07:14:10",
    "text": "やめろー!",
    "audio_file": "clip_021.mp3"
  },
  {
    "start": "07:14:15",
    "end": "07:14:21",
    "text": "僕の記憶に / 勝手に入ってくるな",
    "audio_file": "clip_022.mp3"
  },
  {
    "start": "07:14:22",
    "end": "07:14:26",
    "text": "これは僕らが殺してやる",
    "audio_file": "clip_023.mp3"
  },
  {
    "start": "07:14:31",
    "end": "07:14:38",
    "text": "僕ら / 僕の記憶を",
    "audio_file": "clip_024.mp3"
  },
  {
    "start": "07:15:07",
    "end": "07:15:10",
    "text": "あははははは",
    "audio_file": "clip_025.mp3"
  }
]