[
  {
    "start": "08:51:39",
    "end": "08:51:44",
    "text": "うーん",
    "audio_file": "clip_000.mp3"
  },
  {
    "start": "08:51:50",
    "end": "08:51:57",
    "text": "ひゃっ / くし… / ううう… / ううっ あー!",
    "audio_file": "clip_001.mp3"
  },
  {
    "start": "08:51:58",
    "end": "08:52:05",
    "text": "ああっ… / ああっ… / ポッド! / あ… 発見です! / ああっ… / ああっ… / 了快",
    "audio_file": "clip_002.mp3"
  },
  {
    "start": "08:52:08",
    "end": "08:52:11",
    "text": "あ… / はぁ…",
    "audio_file": "clip_003.mp3"
  },
  {
    "start": "08:52:15",
    "end": "08:52:21",
    "text": "ポット、9Sの論理回路を修復する / 了解",
    "audio_file": "clip_004.mp3"
  },
  {
    "start": "08:52:28",
    "end": "08:52:34",
    "text": "9Sを汚染しているウイルスの場所を教えてくれ / 了解、ヨルハ機体A2",
    "audio_file": "clip_005.mp3"
  },
  {
    "start": "08:52:35",
    "end": "08:52:38",
    "text": "この先に、9Sのコアデータが格納されている",
    "audio_file": "clip_006.mp3"
  },
  {
    "start": "08:52:39",
    "end": "08:52:48",
    "text": "報告、ウイルスを戦が深刻で、除去は困難 / いや、一つだけ方法があるはずだ",
    "audio_file": "clip_007.mp3"
  },
  {
    "start": "08:52:48",
    "end": "08:52:53",
    "text": "その方法は推奨できない / 私はヨルハ部隊支援追行ユニット",
    "audio_file": "clip_008.mp3"
  },
  {
    "start": "08:52:54",
    "end": "08:53:04",
    "text": "支援しているヨルハ機隊A2にガイドなす行動には賛同できない / 意外と、いいやつだな、お前は",
    "audio_file": "clip_009.mp3"
  },
  {
    "start": "08:54:01",
    "end": "08:54:05",
    "text": "私は… / 全部",
    "audio_file": "clip_010.mp3"
  },
  {
    "start": "08:54:10",
    "end": "08:54:13",
    "text": "ポット",
    "audio_file": "clip_011.mp3"
  },
  {
    "start": "08:54:13",
    "end": "08:54:17",
    "text": "9Sを頼む",
    "audio_file": "clip_012.mp3"
  },
  {
    "start": "08:54:20",
    "end": "08:54:28",
    "text": "A2 君は? / 私はまだ やることがあるから",
    "audio_file": "clip_013.mp3"
  },
  {
    "start": "08:54:28",
    "end": "08:54:30",
    "text": "先に行ってくれ",
    "audio_file": "clip_014.mp3"
  },
  {
    "start": "08:54:31",
    "end": "08:54:34",
    "text": "了解",
    "audio_file": "clip_015.mp3"
  },
  {
    "start": "08:54:58",
    "end": "08:55:01",
    "text": "すまないな",
    "audio_file": "clip_016.mp3"
  },
  {
    "start": "08:55:03",
    "end": "08:55:16",
    "text": "そんなに世界がキレイだって",
    "audio_file": "clip_017.mp3"
  },
  {
    "start": "08:55:17",
    "end": "08:55:20",
    "text": "気づかなかったな",
    "audio_file": "clip_018.mp3"
  },
  {
    "start": "08:55:21",
    "end": "08:55:28",
    "text": "みんな / 今行くよ / -",
    "audio_file": "clip_019.mp3"
  },
  {
    "start": "08:55:53",
    "end": "08:56:16",
    "text": "第1話 アリカメラ",
    "audio_file": "clip_020.mp3"
  }
]