[
  {
    "start": "05:55:53",
    "end": "05:55:56",
    "text": "あっ",
    "audio_file": "clip_000.mp3"
  },
  {
    "start": "05:55:58",
    "end": "05:56:02",
    "text": "チパー",
    "audio_file": "clip_001.mp3"
  },
  {
    "start": "05:56:19",
    "end": "05:56:22",
    "text": "これで…",
    "audio_file": "clip_002.mp3"
  },
  {
    "start": "05:56:22",
    "end": "05:56:24",
    "text": "全部",
    "audio_file": "clip_003.mp3"
  },
  {
    "start": "05:56:46",
    "end": "05:56:49",
    "text": "失敗しちゃった",
    "audio_file": "clip_004.mp3"
  },
  {
    "start": "05:56:55",
    "end": "05:57:04",
    "text": "イヴのネットワーク分離時に物理汚染されちゃったみたい",
    "audio_file": "clip_005.mp3"
  },
  {
    "start": "05:57:05",
    "end": "05:57:09",
    "text": "そんな / 大丈夫",
    "audio_file": "clip_006.mp3"
  },
  {
    "start": "05:57:10",
    "end": "05:57:14",
    "text": "バンカーにあるデータで巻き戻ることができるから",
    "audio_file": "clip_007.mp3"
  },
  {
    "start": "05:57:15",
    "end": "05:57:19",
    "text": "でもそれじゃ今の君は戻ってこない",
    "audio_file": "clip_008.mp3"
  },
  {
    "start": "05:57:20",
    "end": "05:57:22",
    "text": "そうだね",
    "audio_file": "clip_009.mp3"
  },
  {
    "start": "05:57:22",
    "end": "05:57:29",
    "text": "汚染データをバンカーにアップロードするわけにも",
    "audio_file": "clip_010.mp3"
  },
  {
    "start": "05:57:29",
    "end": "05:57:31",
    "text": "いかないか",
    "audio_file": "clip_011.mp3"
  },
  {
    "start": "05:57:33",
    "end": "05:57:40",
    "text": "ないいえさ / まだ",
    "audio_file": "clip_012.mp3"
  },
  {
    "start": "05:57:40",
    "end": "05:57:45",
    "text": "你看 / 对 / 这边",
    "audio_file": "clip_013.mp3"
  },
  {
    "start": "05:57:46",
    "end": "05:57:50",
    "text": "我可 / 是你都",
    "audio_file": "clip_014.mp3"
  },
  {
    "start": "05:57:50",
    "end": "05:57:53",
    "text": "在",
    "audio_file": "clip_015.mp3"
  },
  {
    "start": "05:59:55",
    "end": "06:00:00",
    "text": "まだ残ってるのか",
    "audio_file": "clip_016.mp3"
  },
  {
    "start": "06:00:10",
    "end": "06:00:15",
    "text": "こんな機械",
    "audio_file": "clip_017.mp3"
  },
  {
    "start": "06:00:21",
    "end": "06:00:24",
    "text": "これは通信?",
    "audio_file": "clip_018.mp3"
  },
  {
    "start": "06:00:24",
    "end": "06:00:28",
    "text": "データ信号が共鳴しあって",
    "audio_file": "clip_019.mp3"
  },
  {
    "start": "06:01:01",
    "end": "06:01:05",
    "text": "ちょっと待って2B / 君は",
    "audio_file": "clip_020.mp3"
  },
  {
    "start": "06:01:05",
    "end": "06:01:09",
    "text": "僕パーソナルデータを機械生命体側に残していたみたいで",
    "audio_file": "clip_021.mp3"
  },
  {
    "start": "06:01:10",
    "end": "06:01:13",
    "text": "なんか気づいたら周囲のネットワークの上で自我が再形成されたんだ",
    "audio_file": "clip_022.mp3"
  },
  {
    "start": "06:01:14",
    "end": "06:01:18",
    "text": "こうやって複数の自我が統合されていくのは貴重な体験だから記録しておきたいんだけど",
    "audio_file": "clip_023.mp3"
  },
  {
    "start": "06:01:19",
    "end": "06:01:26",
    "text": "まだ保存領域へのアクセスができてなくて / とりあえずこの辺りにある敵のメモリーに多重化して保存しておいた後に / 僕が自分のボディに戻れない",
    "audio_file": "clip_024.mp3"
  },
  {
    "start": "06:01:27",
    "end": "06:01:31",
    "text": "イエス / よかった",
    "audio_file": "clip_025.mp3"
  },
  {
    "start": "06:01:31",
    "end": "06:01:34",
    "text": "うん",
    "audio_file": "clip_026.mp3"
  },
  {
    "start": "06:01:44",
    "end": "06:01:49",
    "text": "こうやって / アダムとイブを巡る / 最後の戦いは終わった",
    "audio_file": "clip_027.mp3"
  },
  {
    "start": "06:01:50",
    "end": "06:02:00",
    "text": "この戦いは / 戦局に大きな影響をもたらすだろう / 僕と2Bの戦いもこの後まだしばらく続くんだけど",
    "audio_file": "clip_028.mp3"
  },
  {
    "start": "06:02:01",
    "end": "06:02:07",
    "text": "それはまた別の話",
    "audio_file": "clip_029.mp3"
  },
  {
    "start": "06:02:11",
    "end": "06:02:17",
    "text": "思い返せ / 故郷を奪われた苦しみを",
    "audio_file": "clip_030.mp3"
  },
  {
    "start": "06:02:18",
    "end": "06:02:24",
    "text": "我々は諦めはしない / 海を空を大地を",
    "audio_file": "clip_031.mp3"
  },
  {
    "start": "06:02:25",
    "end": "06:02:29",
    "text": "おぞましき機械生命体に奪われた地球を取り戻す",
    "audio_file": "clip_032.mp3"
  },
  {
    "start": "06:02:30",
    "end": "06:02:35",
    "text": "本作戦の成功をもって / 今ここでこの戦争を終わらせるのだ",
    "audio_file": "clip_033.mp3"
  },
  {
    "start": "06:02:36",
    "end": "06:02:39",
    "text": "人類に栄光あれ",
    "audio_file": "clip_034.mp3"
  },
  {
    "start": "06:02:40",
    "end": "06:02:46",
    "text": "人類に栄光あれ",
    "audio_file": "clip_035.mp3"
  }
]