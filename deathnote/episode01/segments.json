[
  {
    "start": "00:55",
    "end": "00:59",
    "text": "おま / え",
    "audio_file": "clip_000.mp3"
  },
  {
    "start": "01:00",
    "end": "01:07",
    "text": "俺はいい",
    "audio_file": "clip_001.mp3"
  },
  {
    "start": "01:08",
    "end": "01:11",
    "text": "それで / 私何もしてないのに / 急にキレてきたよ",
    "audio_file": "clip_002.mp3"
  },
  {
    "start": "01:11",
    "end": "01:17",
    "text": "それでそれで / 八神く / んどうしました / 今の文章の和訳をお願いします",
    "audio_file": "clip_003.mp3"
  },
  {
    "start": "01:21",
    "end": "01:25",
    "text": "神の教えに従うべし / さすれば",
    "audio_file": "clip_004.mp3"
  },
  {
    "start": "01:25",
    "end": "01:31",
    "text": "海の恵みは豊かになり / 嵐はやってこないだろう",
    "audio_file": "clip_005.mp3"
  },
  {
    "start": "01:31",
    "end": "01:40",
    "text": "本日午前11時ごろ / 神奈川県横浜市のアパートで / 30前後と見られる男性が / 血まみれで死亡しているところが見つかり",
    "audio_file": "clip_006.mp3"
  },
  {
    "start": "01:41",
    "end": "01:45",
    "text": "神奈川県警は殺人事件と呼びかせ / 次の様子です",
    "audio_file": "clip_007.mp3"
  },
  {
    "start": "01:46",
    "end": "01:53",
    "text": "本日正午過ぎ / 東京都渋谷区で / 同居している25歳の女性に / 暴行を加え殺害したとして",
    "audio_file": "clip_008.mp3"
  },
  {
    "start": "01:54",
    "end": "01:58",
    "text": "35歳の男 / トフジナオキ容疑者が殺人の疑いで逮捕されました",
    "audio_file": "clip_009.mp3"
  },
  {
    "start": "01:59",
    "end": "02:01",
    "text": "毎日毎日",
    "audio_file": "clip_010.mp3"
  },
  {
    "start": "02:02",
    "end": "02:05",
    "text": "同じことの繰り返し",
    "audio_file": "clip_011.mp3"
  },
  {
    "start": "02:06",
    "end": "02:10",
    "text": "まったくくだらねえ",
    "audio_file": "clip_012.mp3"
  },
  {
    "start": "02:11",
    "end": "02:15",
    "text": "この世は腐ってる",
    "audio_file": "clip_013.mp3"
  },
  {
    "start": "02:29",
    "end": "02:32",
    "text": "次回予告",
    "audio_file": "clip_014.mp3"
  },
  {
    "start": "03:04",
    "end": "03:09",
    "text": "デスノート / 直訳で死のノート",
    "audio_file": "clip_015.mp3"
  },
  {
    "start": "03:11",
    "end": "03:19",
    "text": "使い方 / このノートに名前を書かれた人間は死ぬ",
    "audio_file": "clip_016.mp3"
  },
  {
    "start": "03:21",
    "end": "03:22",
    "text": "くだらない",
    "audio_file": "clip_017.mp3"
  },
  {
    "start": "03:23",
    "end": "03:30",
    "text": "まったく病んでるな / 不幸の手紙から全然進歩しちゃいない",
    "audio_file": "clip_018.mp3"
  },
  {
    "start": "03:31",
    "end": "03:34",
    "text": "何が名前を書かれた人間は死ぬだ",
    "audio_file": "clip_019.mp3"
  },
  {
    "start": "03:43",
    "end": "03:47",
    "text": "まったくどうかしてるな僕も",
    "audio_file": "clip_020.mp3"
  },
  {
    "start": "03:50",
    "end": "03:54",
    "text": "各人物の顔が頭に入っていないと効果はない",
    "audio_file": "clip_021.mp3"
  },
  {
    "start": "03:54",
    "end": "03:59",
    "text": "故に同性同名の人物に一変に効果は得られない",
    "audio_file": "clip_022.mp3"
  },
  {
    "start": "03:59",
    "end": "04:06",
    "text": "名前の後に人間界単位で40秒以内に死因を書くとその通りになる",
    "audio_file": "clip_023.mp3"
  },
  {
    "start": "04:06",
    "end": "04:16",
    "text": "書かなければ死因は全て心臓麻痺になる / 死因を書くとさらに6分40秒 / 詳しい死の状況を記載する時間が与えられる",
    "audio_file": "clip_024.mp3"
  },
  {
    "start": "04:17",
    "end": "04:22",
    "text": "楽に死なせたり苦しませて死なせたりできるってことか",
    "audio_file": "clip_025.mp3"
  },
  {
    "start": "04:22",
    "end": "04:26",
    "text": "いたずらもここまで手が込んでくるとまあまあかな",
    "audio_file": "clip_026.mp3"
  },
  {
    "start": "04:32",
    "end": "04:36",
    "text": "名前を書くと死ぬか",
    "audio_file": "clip_027.mp3"
  },
  {
    "start": "04:36",
    "end": "04:39",
    "text": "本当にくだらない",
    "audio_file": "clip_028.mp3"
  },
  {
    "start": "04:54",
    "end": "04:59",
    "text": "待てよ / 万が一本当に死んだら僕は殺人犯か",
    "audio_file": "clip_029.mp3"
  },
  {
    "start": "05:01",
    "end": "05:05",
    "text": "まさかなそんなわけあるはずない",
    "audio_file": "clip_030.mp3"
  },
  {
    "start": "05:05",
    "end": "05:09",
    "text": "昨日新宿の繁華街で6人もの人を殺傷した通り魔は",
    "audio_file": "clip_031.mp3"
  },
  {
    "start": "05:09",
    "end": "05:14",
    "text": "今なお幼児と保育士8人を人質にこの保育園に立てこもっております",
    "audio_file": "clip_032.mp3"
  },
  {
    "start": "05:14",
    "end": "05:19",
    "text": "警視庁は犯人を音原田九郎無職42歳と断定",
    "audio_file": "clip_033.mp3"
  },
  {
    "start": "05:19",
    "end": "05:21",
    "text": "説得を開始する模様です",
    "audio_file": "clip_034.mp3"
  },
  {
    "start": "05:27",
    "end": "05:31",
    "text": "40秒で心臓麻痺だったな",
    "audio_file": "clip_035.mp3"
  },
  {
    "start": "05:33",
    "end": "05:40",
    "text": "今のところよくわかっておりません / 人質の方のアウリが何より気になりますね / そうですね",
    "audio_file": "clip_036.mp3"
  },
  {
    "start": "05:40",
    "end": "05:44",
    "text": "以上現場からお伝えしました / ありがとうございました",
    "audio_file": "clip_037.mp3"
  },
  {
    "start": "05:45",
    "end": "05:51",
    "text": "いかがでしょう橋本さん / いや一刻も早い解決を望みますね",
    "audio_file": "clip_038.mp3"
  },
  {
    "start": "05:51",
    "end": "05:57",
    "text": "やっぱり何も起こらない / ま、当たり前か",
    "audio_file": "clip_039.mp3"
  },
  {
    "start": "05:57",
    "end": "06:01",
    "text": "あ、ちょっと待ってください / 動きがあったようです",
    "audio_file": "clip_040.mp3"
  },
  {
    "start": "06:01",
    "end": "06:07",
    "text": "人質が出てきました / 皆無事のようです / 入れ替わるように機動隊が突入",
    "audio_file": "clip_041.mp3"
  },
  {
    "start": "06:08",
    "end": "06:13",
    "text": "犯人逮捕でしょうか / はい / たった今、情報が入りました",
    "audio_file": "clip_042.mp3"
  },
  {
    "start": "06:13",
    "end": "06:17",
    "text": "犯人は保育園内で死亡 / 犯人は死亡した模様です",
    "audio_file": "clip_043.mp3"
  },
  {
    "start": "06:18",
    "end": "06:19",
    "text": "死亡?",
    "audio_file": "clip_044.mp3"
  },
  {
    "start": "06:20",
    "end": "06:24",
    "text": "機動隊は射殺したのではないと強調しております",
    "audio_file": "clip_045.mp3"
  },
  {
    "start": "06:25",
    "end": "06:38",
    "text": "では追い詰められての自殺ということでしょうか / それが人質の証言では犯人は突然倒れたと話しています / 心臓麻痺",
    "audio_file": "clip_046.mp3"
  },
  {
    "start": "06:39",
    "end": "06:42",
    "text": "いや偶然だ偶然に決まってる",
    "audio_file": "clip_047.mp3"
  },
  {
    "start": "06:43",
    "end": "06:44",
    "text": "ライト",
    "audio_file": "clip_048.mp3"
  },
  {
    "start": "06:45",
    "end": "06:49",
    "text": "もう6時半になるわよ / 今日は塾の日でしょ",
    "audio_file": "clip_049.mp3"
  },
  {
    "start": "06:49",
    "end": "06:52",
    "text": "まあ今試作してるとこ",
    "audio_file": "clip_050.mp3"
  },
  {
    "start": "06:53",
    "end": "06:57",
    "text": "デスノート / でも万一これが本物だとしたら",
    "audio_file": "clip_051.mp3"
  },
  {
    "start": "06:58",
    "end": "07:06",
    "text": "もう一度試してみる価値はある / そうなるとやはり犯罪者か / しかしあまり大物でもまずい",
    "audio_file": "clip_052.mp3"
  },
  {
    "start": "07:07",
    "end": "07:11",
    "text": "たとえ死んでもその事実をしばらく隠される可能性がある",
    "audio_file": "clip_053.mp3"
  },
  {
    "start": "07:12",
    "end": "07:14",
    "text": "すぐに結果が欲しい",
    "audio_file": "clip_054.mp3"
  },
  {
    "start": "07:14",
    "end": "07:24",
    "text": "よう両親 / な、何ですどうか / 2000円でいいから貸してよ / え?またですか? / 須藤 / 殺 / してみ / るか",
    "audio_file": "clip_055.mp3"
  },
  {
    "start": "07:25",
    "end": "07:29",
    "text": "いや身近な人間はなるべく避けた方がいいな",
    "audio_file": "clip_056.mp3"
  },
  {
    "start": "07:31",
    "end": "07:36",
    "text": "いやそんな気にすることもないか / どうせあんな奴の一人や二人",
    "audio_file": "clip_057.mp3"
  },
  {
    "start": "07:37",
    "end": "07:39",
    "text": "死んでも誰も何も思わない",
    "audio_file": "clip_058.mp3"
  },
  {
    "start": "07:40",
    "end": "07:48",
    "text": "これで帰りゲーセン行くぜ / アッキー明日合コンやるんだけど来ない? / 行く行く / 私も",
    "audio_file": "clip_059.mp3"
  },
  {
    "start": "07:49",
    "end": "07:53",
    "text": "なんだよ / うちのバ / バア / 迎えに来て / ねえじゃねえかよ",
    "audio_file": "clip_060.mp3"
  },
  {
    "start": "07:53",
    "end": "08:03",
    "text": "まったく / こうなるとどいつもこいつも / 殺した方が世の中のためになるやつばかりに見えてくる",
    "audio_file": "clip_061.mp3"
  },
  {
    "start": "08:04",
    "end": "08:06",
    "text": "お姉さーん",
    "audio_file": "clip_062.mp3"
  },
  {
    "start": "08:07",
    "end": "08:12",
    "text": "今から俺らと遊ばんない / さすがタクさん / すんげえ美人ゲット",
    "audio_file": "clip_063.mp3"
  },
  {
    "start": "08:13",
    "end": "08:16",
    "text": "俺渋いまるタクを / 略して渋タク",
    "audio_file": "clip_064.mp3"
  },
  {
    "start": "08:17",
    "end": "08:21",
    "text": "付き合ってよ、素敵なお姉さーん / こ、困ります",
    "audio_file": "clip_065.mp3"
  },
  {
    "start": "08:22",
    "end": "08:25",
    "text": "困ります?だって、キャワイイ!",
    "audio_file": "clip_066.mp3"
  },
  {
    "start": "08:28",
    "end": "08:33",
    "text": "めくって!逃して全部! / え?いいんすか?",
    "audio_file": "clip_067.mp3"
  },
  {
    "start": "08:34",
    "end": "08:37",
    "text": "やめて! / やめて!",
    "audio_file": "clip_068.mp3"
  },
  {
    "start": "08:38",
    "end": "08:43",
    "text": "やめて!",
    "audio_file": "clip_069.mp3"
  },
  {
    "start": "08:44",
    "end": "08:48",
    "text": "さあ、どうなる?",
    "audio_file": "clip_070.mp3"
  },
  {
    "start": "08:49",
    "end": "08:58",
    "text": "待ってよ! / あったく、危ねえ!",
    "audio_file": "clip_071.mp3"
  },
  {
    "start": "08:59",
    "end": "09:03",
    "text": "き、決まりだ! / デスモート、本物だ!",
    "audio_file": "clip_072.mp3"
  },
  {
    "start": "09:04",
    "end": "09:08",
    "text": "あったく、 / バカ野郎! / キュリトギレジャガト!",
    "audio_file": "clip_073.mp3"
  },
  {
    "start": "09:11",
    "end": "09:16",
    "text": "さて、そろそろ行くか。",
    "audio_file": "clip_074.mp3"
  },
  {
    "start": "09:28",
    "end": "09:31",
    "text": "あれからいつか。",
    "audio_file": "clip_075.mp3"
  },
  {
    "start": "09:32",
    "end": "09:37",
    "text": "さて、そろそろ行くか。 / うん、お出かけか、リュウク。",
    "audio_file": "clip_076.mp3"
  },
  {
    "start": "09:38",
    "end": "09:41",
    "text": "ここは / どこ行ったって不毛だぜ。",
    "audio_file": "clip_077.mp3"
  },
  {
    "start": "09:42",
    "end": "09:45",
    "text": "デスノート落としちまった",
    "audio_file": "clip_078.mp3"
  },
  {
    "start": "09:46",
    "end": "09:52",
    "text": "今度はまたすげえドジしたな / つーかおめえジジイダマクラ化して2冊持ってたじゃねえか",
    "audio_file": "clip_079.mp3"
  },
  {
    "start": "09:53",
    "end": "09:58",
    "text": "2冊とも落としたのかよ / で、どこに落としたかわかってるわけ?",
    "audio_file": "clip_080.mp3"
  },
  {
    "start": "09:59",
    "end": "10:30",
    "text": "下界 / 诶",
    "audio_file": "clip_081.mp3"
  },
  {
    "start": "10:31",
    "end": "10:38",
    "text": "おかえり、早かったわね、ライト。 / ああ、ただいま、母さん。",
    "audio_file": "clip_082.mp3"
  },
  {
    "start": "10:38",
    "end": "10:39",
    "text": "ん?",
    "audio_file": "clip_083.mp3"
  },
  {
    "start": "10:40",
    "end": "10:45",
    "text": "ああ、全国模試の結果ね。 / 早く。",
    "audio_file": "clip_084.mp3"
  },
  {
    "start": "10:45",
    "end": "10:46",
    "text": "はい。",
    "audio_file": "clip_085.mp3"
  },
  {
    "start": "10:47",
    "end": "10:51",
    "text": "あら、また1位。 / 頑張ったわね、ライト。",
    "audio_file": "clip_086.mp3"
  },
  {
    "start": "10:52",
    "end": "10:55",
    "text": "まあね、じゃあ勉強するから邪魔しないでね。",
    "audio_file": "clip_087.mp3"
  },
  {
    "start": "10:55",
    "end": "11:00",
    "text": "はいはい。 / ライト、何か欲しいものはないの?",
    "audio_file": "clip_088.mp3"
  },
  {
    "start": "11:01",
    "end": "11:04",
    "text": "何でも言って! / 別にないよ、母さん。",
    "audio_file": "clip_089.mp3"
  },
  {
    "start": "11:06",
    "end": "11:09",
    "text": "欲しいものは手に入った。",
    "audio_file": "clip_090.mp3"
  },
  {
    "start": "11:28",
    "end": "11:30",
    "text": "気に入ってるようだな",
    "audio_file": "clip_091.mp3"
  },
  {
    "start": "11:37",
    "end": "11:42",
    "text": "なぜそんなに驚く / そのノートの落とし主",
    "audio_file": "clip_092.mp3"
  },
  {
    "start": "11:43",
    "end": "11:46",
    "text": "死神のリュークだ / さっきの様子だと",
    "audio_file": "clip_093.mp3"
  },
  {
    "start": "11:47",
    "end": "11:51",
    "text": "もうそれがただのノートじゃないって / わかってるんだろ",
    "audio_file": "clip_094.mp3"
  },
  {
    "start": "11:56",
    "end": "11:58",
    "text": "死神か",
    "audio_file": "clip_095.mp3"
  },
  {
    "start": "12:01",
    "end": "12:05",
    "text": "驚いてないよリュク",
    "audio_file": "clip_096.mp3"
  },
  {
    "start": "12:06",
    "end": "12:11",
    "text": "いや待ってたよリュク / ほう",
    "audio_file": "clip_097.mp3"
  },
  {
    "start": "12:11",
    "end": "12:17",
    "text": "僕はすでに死神のノートを現実だと疑ってなかったが",
    "audio_file": "clip_098.mp3"
  },
  {
    "start": "12:17",
    "end": "12:22",
    "text": "こうしていろんなことを直視することで / ますます確信を持って行動できる",
    "audio_file": "clip_099.mp3"
  },
  {
    "start": "12:22",
    "end": "12:27",
    "text": "なるほどな / お前には驚かされるぜ",
    "audio_file": "clip_100.mp3"
  },
  {
    "start": "12:28",
    "end": "12:33",
    "text": "過去にデスノートが人間界に出回った話は / 俺も何度か聞いたことがあったが",
    "audio_file": "clip_101.mp3"
  },
  {
    "start": "12:34",
    "end": "12:40",
    "text": "たった5日でここまでやったのはお前が初めてだ / 波じゃビビってここまでかけない",
    "audio_file": "clip_102.mp3"
  },
  {
    "start": "12:41",
    "end": "12:46",
    "text": "覚悟はできてるよリュウク / 僕は死神のノートを分かっていて使った",
    "audio_file": "clip_103.mp3"
  },
  {
    "start": "12:46",
    "end": "12:50",
    "text": "そして死神が来た / 僕はどうなる",
    "audio_file": "clip_104.mp3"
  },
  {
    "start": "12:50",
    "end": "12:57",
    "text": "魂を取 / られるのか / ん? / なんだそれ / 人間の作った勝手なイメージか",
    "audio_file": "clip_105.mp3"
  },
  {
    "start": "12:58",
    "end": "13:10",
    "text": "俺はお / 前に何もしない / 人間界の地に着いた時点でノートは人間界のものになる / つまりそいつはもうお前のものだ",
    "audio_file": "clip_106.mp3"
  },
  {
    "start": "13:11",
    "end": "13:12",
    "text": "僕のもの",
    "audio_file": "clip_107.mp3"
  },
  {
    "start": "13:13",
    "end": "13:20",
    "text": "いらなきゃ他の人間に回せ / その時はお前のデスノートに関する記憶だけ消させてもらう",
    "audio_file": "clip_108.mp3"
  },
  {
    "start": "13:20",
    "end": "13:25",
    "text": "じゃあ本当にデスノートを使った代償って / 何もないんだな",
    "audio_file": "clip_109.mp3"
  },
  {
    "start": "13:25",
    "end": "13:32",
    "text": "強いて言えば / そのノートを使った人間にしか訪れない苦悩や恐怖",
    "audio_file": "clip_110.mp3"
  },
  {
    "start": "13:33",
    "end": "13:37",
    "text": "そしてお前が死んだ時 / 俺がお前の名前を",
    "audio_file": "clip_111.mp3"
  },
  {
    "start": "13:38",
    "end": "13:43",
    "text": "俺のノートに書くことになるが / デスノートを使った人間が",
    "audio_file": "clip_112.mp3"
  },
  {
    "start": "13:44",
    "end": "13:47",
    "text": "天国や地獄に行けると思うな",
    "audio_file": "clip_113.mp3"
  },
  {
    "start": "13:48",
    "end": "13:53",
    "text": "それだけ / だ",
    "audio_file": "clip_114.mp3"
  },
  {
    "start": "13:54",
    "end": "13:57",
    "text": "死んでからのお楽しみだ",
    "audio_file": "clip_115.mp3"
  },
  {
    "start": "13:59",
    "end": "14:04",
    "text": "はっ / ライト / 大丈夫だ 出てみろ",
    "audio_file": "clip_116.mp3"
  },
  {
    "start": "14:06",
    "end": "14:19",
    "text": "なに / リンゴ持ってきたわよ お隣さんからお裾分け / なにこんな暗くして 目悪くするわよ / どういうことだ 母さんには見えていないのか",
    "audio_file": "clip_117.mp3"
  },
  {
    "start": "14:20",
    "end": "14:24",
    "text": "そのノートはもともと俺が持っていたものだ",
    "audio_file": "clip_118.mp3"
  },
  {
    "start": "14:25",
    "end": "14:30",
    "text": "それを使うことになったお前だけが / 俺の姿を見ることができる",
    "audio_file": "clip_119.mp3"
  },
  {
    "start": "14:30",
    "end": "14:38",
    "text": "もちろん声もお前にしか聞こえない / いわばデスノートは / 人間ライトと死神リュークを繋ぐ絆だ",
    "audio_file": "clip_120.mp3"
  },
  {
    "start": "14:41",
    "end": "14:45",
    "text": "うまい / じゃあもう一つ聞くけど",
    "audio_file": "clip_121.mp3"
  },
  {
    "start": "14:46",
    "end": "14:48",
    "text": "なぜ僕を選んだ",
    "audio_file": "clip_122.mp3"
  },
  {
    "start": "14:48",
    "end": "14:51",
    "text": "おい聞いてるのか",
    "audio_file": "clip_123.mp3"
  },
  {
    "start": "14:53",
    "end": "14:58",
    "text": "すごいぜ人間界のリンゴは / こういうのなんて言うんだ",
    "audio_file": "clip_124.mp3"
  },
  {
    "start": "14:58",
    "end": "15:02",
    "text": "ジューシー / 質問に答えろよ",
    "audio_file": "clip_125.mp3"
  },
  {
    "start": "15:02",
    "end": "15:06",
    "text": "選んじゃいない / 俺はただノートを落としただけだ",
    "audio_file": "clip_126.mp3"
  },
  {
    "start": "15:07",
    "end": "15:11",
    "text": "賢い自分が選ばれたとでも思ったのか / うぬぼれるな",
    "audio_file": "clip_127.mp3"
  },
  {
    "start": "15:12",
    "end": "15:17",
    "text": "たまたまこの辺りに落ち / たまたまお前が拾った / それだけのことだ",
    "audio_file": "clip_128.mp3"
  },
  {
    "start": "15:18",
    "end": "15:22",
    "text": "だから人間界で一番ポピュラーな英語で説明をつけたんだぜ",
    "audio_file": "clip_129.mp3"
  },
  {
    "start": "15:23",
    "end": "15:29",
    "text": "じゃあなぜ落とした / 丁寧に使い方まで書いて / 間違って落としたなんて言うなよ",
    "audio_file": "clip_130.mp3"
  },
  {
    "start": "15:30",
    "end": "15:34",
    "text": "なぜかって / 退屈だった / から",
    "audio_file": "clip_131.mp3"
  },
  {
    "start": "15:35",
    "end": "15:36",
    "text": "退屈",
    "audio_file": "clip_132.mp3"
  },
  {
    "start": "15:37",
    "end": "15:41",
    "text": "実際今の死神ってのは暇でね",
    "audio_file": "clip_133.mp3"
  },
  {
    "start": "15:42",
    "end": "15:51",
    "text": "昼寝してるか博打ってるかだ / 下手にデスノートに名前なんて書いてると / 何 / 頑張っちゃってるのって笑われる",
    "audio_file": "clip_134.mp3"
  },
  {
    "start": "15:52",
    "end": "15:57",
    "text": "死神界のやつをノートに書いても死なない / かといって自分は死神界にいるのに",
    "audio_file": "clip_135.mp3"
  },
  {
    "start": "15:58",
    "end": "16:01",
    "text": "人間界のやつを殺しても面白くもなんともない",
    "audio_file": "clip_136.mp3"
  },
  {
    "start": "16:01",
    "end": "16:07",
    "text": "こっちに来る方が面白いと俺は踏んだ",
    "audio_file": "clip_137.mp3"
  },
  {
    "start": "16:08",
    "end": "16:11",
    "text": "それにしても随分名前書いたな",
    "audio_file": "clip_138.mp3"
  },
  {
    "start": "16:12",
    "end": "16:15",
    "text": "しかし / なんでダンプに跳ねられたやつしか死因を書いてないんだ",
    "audio_file": "clip_139.mp3"
  },
  {
    "start": "16:16",
    "end": "16:19",
    "text": "死因を書かなければみんな心臓麻痺で死ぬ",
    "audio_file": "clip_140.mp3"
  },
  {
    "start": "16:20",
    "end": "16:23",
    "text": "そこがデスノートの一番いいところだよリュック",
    "audio_file": "clip_141.mp3"
  },
  {
    "start": "16:24",
    "end": "16:28",
    "text": "すでに主だった犯罪者の名前は書き尽くし",
    "audio_file": "clip_142.mp3"
  },
  {
    "start": "16:29",
    "end": "16:32",
    "text": "徐々に悪人のレベルも下げてる / それがなんだと言うんだ",
    "audio_file": "clip_143.mp3"
  },
  {
    "start": "16:33",
    "end": "16:37",
    "text": "どんなバカでも悪人が誰かに消されているってことに気づくだろ",
    "audio_file": "clip_144.mp3"
  },
  {
    "start": "16:38",
    "end": "16:41",
    "text": "世の中に知らしめるんだ / 僕の存在を",
    "audio_file": "clip_145.mp3"
  },
  {
    "start": "16:42",
    "end": "16:45",
    "text": "正義の裁きを下す者がいるってこと",
    "audio_file": "clip_146.mp3"
  },
  {
    "start": "16:46",
    "end": "16:51",
    "text": "いやしかし正義の裁きを下してどうするつもりだ",
    "audio_file": "clip_147.mp3"
  },
  {
    "start": "16:51",
    "end": "16:57",
    "text": "なぜそんなこと / 僕も退屈だったから",
    "audio_file": "clip_148.mp3"
  },
  {
    "start": "16:59",
    "end": "17:03",
    "text": "もちろん最初は信じなかった / でもそのノートには",
    "audio_file": "clip_149.mp3"
  },
  {
    "start": "17:04",
    "end": "17:08",
    "text": "人間なら誰でも一度は試してみたくなる / 僕がある",
    "audio_file": "clip_150.mp3"
  },
  {
    "start": "17:10",
    "end": "17:14",
    "text": "殺してしまった / 二人も",
    "audio_file": "clip_151.mp3"
  },
  {
    "start": "17:14",
    "end": "17:16",
    "text": "この僕が",
    "audio_file": "clip_152.mp3"
  },
  {
    "start": "17:17",
    "end": "17:20",
    "text": "命だ / 軽いはずがない",
    "audio_file": "clip_153.mp3"
  },
  {
    "start": "17:21",
    "end": "17:25",
    "text": "僕に勝手に人を裁く権利があるのか",
    "audio_file": "clip_154.mp3"
  },
  {
    "start": "17:26",
    "end": "17:32",
    "text": "いや / 違う / いつも思ってたことじゃないか",
    "audio_file": "clip_155.mp3"
  },
  {
    "start": "17:32",
    "end": "17:37",
    "text": "世の中腐っている / 腐ってる奴は死んだ方がいい",
    "audio_file": "clip_156.mp3"
  },
  {
    "start": "17:37",
    "end": "17:41",
    "text": "誰かが、誰かがやらなくてはいけないんだ",
    "audio_file": "clip_157.mp3"
  },
  {
    "start": "17:42",
    "end": "17:45",
    "text": "自らの精神や命を犠牲にしてでも",
    "audio_file": "clip_158.mp3"
  },
  {
    "start": "17:45",
    "end": "17:52",
    "text": "このままじゃいけないんだ / もし他の誰かがこのノートを拾ったとして",
    "audio_file": "clip_159.mp3"
  },
  {
    "start": "17:53",
    "end": "17:56",
    "text": "この世に不必要な人間を消すことのできる奴がいるか",
    "audio_file": "clip_160.mp3"
  },
  {
    "start": "17:56",
    "end": "17:57",
    "text": "いるわけがない",
    "audio_file": "clip_161.mp3"
  },
  {
    "start": "17:58",
    "end": "18:02",
    "text": "でも僕なら、僕にならできる",
    "audio_file": "clip_162.mp3"
  },
  {
    "start": "18:03",
    "end": "18:06",
    "text": "いや、僕にしかできないんだ",
    "audio_file": "clip_163.mp3"
  },
  {
    "start": "18:06",
    "end": "18:48",
    "text": "やろう、デスノードで / 世の中を変えてやる",
    "audio_file": "clip_164.mp3"
  },
  {
    "start": "18:49",
    "end": "18:54",
    "text": "まずは地球の掃除と思って / 凶悪犯の名前を書き続けた",
    "audio_file": "clip_165.mp3"
  },
  {
    "start": "18:54",
    "end": "18:58",
    "text": "やがて誰も悪いことができなくなるように",
    "audio_file": "clip_166.mp3"
  },
  {
    "start": "18:59",
    "end": "19:03",
    "text": "そして罪を受けて当然な悪人が心臓麻痺で死んでいく裏で",
    "audio_file": "clip_167.mp3"
  },
  {
    "start": "19:04",
    "end": "19:07",
    "text": "道徳のない人間 / 人に迷惑をかける人間を",
    "audio_file": "clip_168.mp3"
  },
  {
    "start": "19:08",
    "end": "19:15",
    "text": "病死や自己死で少しずつ消していく / そうすれば確実に世界はいい方向に進んでいく",
    "audio_file": "clip_169.mp3"
  },
  {
    "start": "19:16",
    "end": "19:22",
    "text": "そして僕が認めた真面目で心の優しい人間だけの世界を作り上げていく",
    "audio_file": "clip_170.mp3"
  },
  {
    "start": "19:23",
    "end": "19:26",
    "text": "そんなことしたら性格悪いのお前だけになるぞ",
    "audio_file": "clip_171.mp3"
  },
  {
    "start": "19:27",
    "end": "19:34",
    "text": "何を言ってるんだ / リュク僕 / は日本一と言ってもいいくらいの真面目な優等生だよ",
    "audio_file": "clip_172.mp3"
  },
  {
    "start": "19:36",
    "end": "19:40",
    "text": "そして僕は",
    "audio_file": "clip_173.mp3"
  },
  {
    "start": "19:41",
    "end": "19:44",
    "text": "新世界 / の神となれ",
    "audio_file": "clip_174.mp3"
  },
  {
    "start": "19:45",
    "end": "19:48",
    "text": "やっぱり人間って",
    "audio_file": "clip_175.mp3"
  },
  {
    "start": "19:49",
    "end": "20:17",
    "text": "面白",
    "audio_file": "clip_176.mp3"
  },
  {
    "start": "20:18",
    "end": "20:18",
    "text": "ご視聴ありがとうございました",
    "audio_file": "clip_177.mp3"
  }
]